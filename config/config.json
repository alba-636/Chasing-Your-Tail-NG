{
  "analysis_window_hours": 48,
  "paths": {
    "log_dir": "logs",
    "kismet_logs": "logs/kismet/*.kismet",
    "ignore_lists": {
      "mac": "mac_list.py",
      "ssid": "ssid_list.py"
    }
  },
  "timing": {
    "check_interval": 60,
    "list_update_interval": 5,
    "time_windows": {
      "recent": 5,
      "medium": 10,
      "old": 15,
      "oldest": 20
    }
  },
  "search": {
    "lat_min": 31.3,
    "lat_max": 37.0,
    "lon_min": -114.8,
    "lon_max": -109.0
  },

  "detector_thresholds": {
    "min_appearances": 3,
    "min_time_span_hours": 1.0,
    "min_persistence_score": 0.5
  },

  "gps_tracker": {
    "location_threshold": 100,
    "session_timeout": 600
  },

  "kismet": {
    "username": "",
    "password": "",
    "url": "localhost",
    "port": 2501
  },

  "telegram": {
    "bot_token": "",
    "chat_id": ""
  }
}